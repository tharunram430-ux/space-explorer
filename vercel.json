{
  "version": 2,
  "installCommand": "npm install && npm --prefix react install --include=dev",
  "buildCommand": "npm --prefix react install --include=dev && npm --prefix react run build",
  "outputDirectory": "react/dist",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/api",
      "destination": "/api/index.js"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
