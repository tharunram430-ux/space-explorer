{
  "name": "space-explorer",
  "version": "1.0.0",
  "private": true,
  "description": "Space Explorer MERN full stack application prepared for Vercel deployment",
  "main": "api/index.js",
  "scripts": {
    "build": "npm --prefix react run build",
    "client": "npm --prefix react run dev",
    "server": "node server/server.js",
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "start": "node server/server.js"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.21.2"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
